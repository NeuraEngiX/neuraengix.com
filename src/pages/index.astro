---
export const prerender = true;
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.tsx';
import StatsBand from '../components/StatsBand.tsx';
import VisionMission from '../components/VisionMission.tsx';
import Principles from '../components/Principles.tsx';
import LogicMind from '../components/LogicMind.tsx';
import Cyber from '../components/Cyber.tsx';
import Demos from '../components/Demos.tsx';
import Pricing from '../components/Pricing.tsx';
import Partnership from '../components/Partnership.tsx';
import CTA from '../components/CTA.tsx';
---

<Base
  title="NeuraEngiX — Amplifying Engineering Intelligence"
  description="NeuraEngiX — Industrial AI, Automation, and OT Cybersecurity. AI-powered PLC engineering with NeuraEngiX LogicMind™ and IEC 62443-aligned OT security for manufacturing."
>
  <Hero client:load />
  <StatsBand />
  <VisionMission client:visible />
  <Principles client:visible />
  <LogicMind client:visible />
  <Cyber client:visible />
  <Demos client:visible />
  <Pricing client:visible />
  <Partnership client:visible />
  <CTA client:visible />
</Base>
