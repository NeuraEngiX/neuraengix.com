---
export const prerender = true;
import Base from '../layouts/Base.astro';
import SolutionPage from '../components/SolutionPage.astro';
import CTA from '../components/CTA.astro';
import { Zap, Workflow, Brain } from 'lucide-react';

const items = [
  {
    icon: Zap,
    title: 'Generate Faster',
    body: 'Convert engineering requirements into PLC logic with AI-assisted code generation.',
  },
  {
    icon: Workflow,
    title: 'Standardize Better',
    body: 'Apply reusable libraries, proven architectures, coding standards, and engineering practices across projects.',
  },
  {
    icon: Brain,
    title: 'Validate Smarter',
    body: 'Automatically check generated logic against FDS requirements and engineering standards to improve quality and reduce rework.',
  },
];
---

<Base
  title="NeuraEngiX LogicMind™ — Industrial AI Platform"
  description="AI-powered PLC engineering. Transform I/O Lists and FDS documents into standardized, validated PLC code with the NeuraEngiX AI Engineering Agent. Vendor-neutral."
>
  <SolutionPage
    eyebrow="NeuraEngiX LogicMind™"
    title="AI-Powered Automation Engineering. From P&ID to Validated Code."
    intro={[
      'Transform P&IDs and FDS documents into standardized I/O lists, PLC code, and HMI screens with the NeuraEngiX LogicMind.',
    ]}
    items={items}
    closing={{
      title: 'Vendor-neutral',
      body: 'Compatible with major PLC platforms.',
    }}
  />
  <CTA />
</Base>
