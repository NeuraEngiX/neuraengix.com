---
import { PlayCircle } from "lucide-react";
import SectionTitle from "./SectionHeader.astro";

// ponytail: swap in real demo video URLs when recorded
const PLACEHOLDER_SRC = "";

const videos = [
  {
    title: "LogicMind™ in Action",
    body: "See how AI accelerates PLC code generation from specifications to deployment.",
    src: PLACEHOLDER_SRC,
    tag: "Product Demo",
  },
  {
    title: "OT Cybersecurity Walkthrough",
    body: "A guided tour of our IEC 62443 assessment and secure network architecture workflow.",
    src: PLACEHOLDER_SRC,
    tag: "Cybersecurity",
  },
  {
    title: "Engineering Workflow Overview",
    body: "How teams standardize libraries, validate logic, and ship projects faster with NeuraEngiX.",
    src: PLACEHOLDER_SRC,
    tag: "Overview",
  },
];
---

<section id="demos" class="relative border-t border-border/40 py-24">
  <div
    class="absolute inset-0 -z-10 opacity-30"
    style={{ background: "radial-gradient(ellipse at center, oklch(0.72 0.13 195 / 0.15), transparent 60%)" }}
  />
  <div class="mx-auto max-w-7xl px-6">
    <SectionTitle
      eyebrow="Demos"
      title="See NeuraEngiX in action"
      subtitle="Short product walkthroughs of LogicMind™, our cybersecurity practice, and end-to-end engineering workflows."
    />
    <div class="grid gap-6 lg:grid-cols-5">
      {/* Featured video */}
      <div class="lg:col-span-3">
        <div class="group overflow-hidden rounded-2xl border border-border bg-card">
          <div class="relative aspect-video w-full overflow-hidden bg-black">
            {videos[0].src ? (
              <iframe
                src={videos[0].src}
                title={videos[0].title}
                loading="lazy"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
                class="absolute inset-0 h-full w-full"
              />
            ) : (
              <div class="flex h-full w-full items-center justify-center bg-background/60 text-xs font-mono uppercase tracking-widest text-muted-foreground">
                Coming soon
              </div>
            )}
          </div>
          <div class="p-7">
            <div class="mb-3 inline-flex items-center gap-1.5 text-[11px] font-semibold uppercase tracking-[0.22em] text-primary">
              <PlayCircle className="h-3.5 w-3.5" />
              {videos[0].tag} · Featured
            </div>
            <h3 class="text-2xl font-semibold leading-tight">{videos[0].title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-muted-foreground">{videos[0].body}</p>
          </div>
        </div>
      </div>
      {/* Secondary videos */}
      <div class="flex flex-col gap-6 lg:col-span-2">
        {videos.slice(1).map(({ title, body, src, tag }) => (
          <div
            class="group flex flex-1 flex-col overflow-hidden rounded-2xl border border-border bg-card transition-colors hover:border-primary/50"
          >
            <div class="relative aspect-video w-full overflow-hidden bg-black">
              {src ? (
                <iframe
                  src={src}
                  title={title}
                  loading="lazy"
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                  allowfullscreen
                  class="absolute inset-0 h-full w-full"
                />
              ) : (
                <div class="flex h-full w-full items-center justify-center bg-background/60 text-xs font-mono uppercase tracking-widest text-muted-foreground">
                  Coming soon
                </div>
              )}
            </div>
            <div class="flex flex-1 flex-col p-5">
              <div class="mb-2 inline-flex items-center gap-1.5 text-[11px] font-semibold uppercase tracking-[0.22em] text-primary">
                <PlayCircle className="h-3.5 w-3.5" />
                {tag}
              </div>
              <h3 class="text-base font-semibold leading-snug">{title}</h3>
              <p class="mt-1.5 text-sm leading-relaxed text-muted-foreground">{body}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
