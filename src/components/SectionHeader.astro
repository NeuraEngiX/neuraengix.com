---
interface Props {
  eyebrow: string;
  title: string;
  subtitle?: string;
}

const { eyebrow, title, subtitle } = Astro.props;
---

<div class="mx-auto mb-14 max-w-3xl text-center">
  <div class="mb-3 text-xs font-semibold uppercase tracking-[0.25em] text-primary">{eyebrow}</div>
  <h2 class="font-display text-4xl font-bold tracking-tight md:text-5xl">{title}</h2>
  {subtitle && <p class="mt-4 text-lg text-muted-foreground">{subtitle}</p>}
</div>
